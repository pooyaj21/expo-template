# Copy to `.env` (gitignored) and fill in.
#
# Only EXPO_PUBLIC_* is inlined into the app bundle by Metro — anything behind
# that prefix is readable by anyone with the IPA. Never put a secret there.

EXPO_PUBLIC_ENVIRONMENT=development

EXPO_PUBLIC_API_DEV_URL=https://api.dev.example.com/v1
EXPO_PUBLIC_API_STAGE_URL=https://api.stage.example.com/v1
EXPO_PUBLIC_API_PROD_URL=https://api.example.com/v1

# ─── Build-time only (not bundled) ───────────────────────────────────────────
# Read by plugins/withAndroidSigning.js during `expo prebuild`. Leave unset and
# the default debug keystore is used, which is what you want locally.
# KEYSTORE_PASSWORD=
# KEY_ALIAS=
# KEY_PASSWORD=
