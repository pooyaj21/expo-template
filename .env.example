# =============================================================================
# App Template env
# =============================================================================
# Two kinds of variable live here:
#
#   EXPO_PUBLIC_*   read at bundle time, INLINED INTO THE JS BUNDLE. Anyone with
#                   the .ipa/.apk can read them, so only publishable keys belong
#                   here.
#   everything else read by app.config.js / local build scripts in Node at
#                   prebuild time. Never reaches the JS bundle.
#
# Restart Metro after changing any EXPO_PUBLIC_* value; re-run `expo prebuild`
# after changing any of the others.
# =============================================================================

# Build flavor: develop | stage | production
#   develop    -> develop API, debug menu on
#   stage      -> stage API,   debug menu on
#   production -> prod API,    debug menu off
EXPO_PUBLIC_FLAVOR=develop

# Per-flavor API base URLs (defaults point at a public JSON API for the example)
EXPO_PUBLIC_API_DEV_URL=https://jsonplaceholder.typicode.com
EXPO_PUBLIC_API_STAGE_URL=https://jsonplaceholder.typicode.com
EXPO_PUBLIC_API_PROD_URL=https://jsonplaceholder.typicode.com

# -----------------------------------------------------------------------------
# Feature flags. env-sourced flags read EXPO_PUBLIC_FLAG_<NAME>.
# Empty / misspelled means "catalog default".
# -----------------------------------------------------------------------------
EXPO_PUBLIC_FLAG_EXAMPLE_DETAIL=true

# -----------------------------------------------------------------------------
# Prebuild only (app.config.js / signing plugins). Not in the JS bundle.
# -----------------------------------------------------------------------------

# Optional. Apple Developer team for iOS prebuild (DEVELOPMENT_TEAM).
APPLE_TEAM_ID=

# Comma-separated https hosts for universal / app links. Empty disables
# ios.associatedDomains and android.intentFilters. Templates: docs/deeplinks/.
APP_LINK_HOSTS=

# Android release signing. Used by local release builds. The keystore FILE is
# gitignored at the repo root as key.jks. Optional KEYSTORE_PATH overrides the
# default ./key.jks for Fastlane lanes.
KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
