# Copy to `.env` (gitignored) and fill in.
#
# Only EXPO_PUBLIC_* is inlined into the app bundle by Metro — anything behind
# that prefix is readable by anyone with the IPA. Never put a secret there.

EXPO_PUBLIC_ENVIRONMENT=development

EXPO_PUBLIC_API_DEV_URL=https://api.dev.example.com/v1
EXPO_PUBLIC_API_STAGE_URL=https://api.stage.example.com/v1
EXPO_PUBLIC_API_PROD_URL=https://api.example.com/v1

# Feature flags (optional env layer). Only "true" / "false" count as overrides;
# unset leaves the decision to server → catalog default.
# EXPO_PUBLIC_FLAG_EXAMPLE_ENABLED=false

# Light Sentry — empty disables init. Never put upload tokens here.
# EXPO_PUBLIC_SENTRY_DSN=

# ─── Build-time only (not bundled) ───────────────────────────────────────────
# Read by plugins/withAndroidSigning.js during `expo prebuild`. Leave unset and
# the default debug keystore is used, which is what you want locally.
# KEYSTORE_PASSWORD=
# KEY_ALIAS=
# KEY_PASSWORD=
#
# Sentry source-map upload (optional). Without SENTRY_AUTH_TOKEN the Expo plugin
# is omitted from app.config.ts so a fresh clone still prebuilds.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
#
# TODO: private `@nizek/localization-provider` is intentionally not wired — keep
# the local `strings.ts` catalog unless the package is available cleanly.
