{
  "name": "app-template",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "build": "bash scripts/build-local.sh",
    "build:develop": "bash scripts/build-local.sh --flavor develop",
    "build:stage": "bash scripts/build-local.sh --flavor stage",
    "build:production": "bash scripts/build-local.sh --flavor production",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type:check": "tsc --noEmit",
    "validate": "npm run format:check && npm run lint && npm run type:check",
    "prepare": "husky",
    "feature": "node ./scripts/new-feature.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": "prettier --write",
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@expo/vector-icons": "~15.0.2",
    "@gorhom/bottom-sheet": "~5.2.8",
    "@pj21/debug-menu": "^1.1.4",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "~2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@shopify/flash-list": "2.3.3",
    "@tanstack/react-query": "~5.80.6",
    "axios": "1.15.0",
    "dotenv": "~17.3.1",
    "expo": "^55.0.19",
    "expo-application": "~55.0.19",
    "expo-blur": "~55.0.18",
    "expo-build-properties": "~55.0.18",
    "expo-constants": "~55.0.15",
    "expo-device": "~55.0.21",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-screen-orientation": "~55.0.20",
    "expo-secure-store": "~55.0.18",
    "expo-sensors": "~55.0.19",
    "expo-splash-screen": "~55.0.19",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.22",
    "expo-web-browser": "~55.0.20",
    "lottie-react-native": "~7.3.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-device-info": "^15.0.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-network-logger": "^2.0.1",
    "react-native-pager-view": "8.0.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "sonner-native": "^0.27.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "~9.39.1",
    "eslint-config-expo": "~55.0.1",
    "eslint-plugin-boundaries": "^7.4.1",
    "husky": "~9.1.7",
    "lint-staged": "~16.1.5",
    "prettier": "~3.6.2",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/flash-list"
      ]
    }
  },
  "overrides": {
    "minimatch": "~10.2.1"
  }
}
